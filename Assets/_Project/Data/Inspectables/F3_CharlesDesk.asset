  m_Script: {fileID: 11500000, guid: 94ef5854df93ba94c8ebc215135562f9, type: 3}
  m_Name: F3_CharlesDesk
  m_EditorClassIdentifier: Overworked::Overworked.DialogueData
  Lines:
  - Speaker: 1
    Text: 'Of all the desks, this one draws the most attention.'
  - Speaker: 1
    Text: 'A pile of trash, crumpled sheets and a dusty nameplate: Charles.'
  - Speaker: 1
    Text: 'There''s a note stuck to the monitor.'
